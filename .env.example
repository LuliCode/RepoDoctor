# 支持工具调用的 OpenAI 或兼容 Chat Completions 服务。请填写实际可用的模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
REPODOCTOR_MODEL=
# lexical 使用 BM25；vector 安装 .[vector]；linearrag 安装 .[linearrag]。两种语义检索共用向量模型。
REPODOCTOR_BACKEND=lexical
# 开启后优先展示精确匹配堆栈、类名或方法名的代码。
REPODOCTOR_EXACT_RERANK=false
REPODOCTOR_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# auto 在 CUDA 可用时使用 GPU，否则使用 CPU；也可显式设 cpu / cuda / cuda:0。
REPODOCTOR_EMBEDDING_DEVICE=auto
# 4 GB 显存建议从 8 或 16 开始；仅影响执行批量，不需要重建向量。
REPODOCTOR_EMBEDDING_BATCH_SIZE=16
REPODOCTOR_MAX_TOOL_CALLS=8
REPODOCTOR_MAX_SECONDS=120
REPODOCTOR_MAX_TOKENS=24000
REPODOCTOR_MAX_CONTEXT_TOKENS=12000
# 可选：将 Hugging Face 模型缓存放在项目内。
HF_HOME=.runtime/huggingface
